# Scratch: screenshots, one-off diagnostic scripts. Never tracked.
tmp/

# Scanner tooling and output. The binaries are downloaded by
# .github/workflows/security.yml and by anyone running them by hand; the SARIF
# is a report, not an artefact to keep.
gitleaks
gitleaks.sarif
gitleaks.tar.gz
actionlint
actionlint.tar.gz
*.sarif

# Mutation testing output. Reports to read, not artefacts to keep.
.stryker-tmp/
reports/
mutants.out/
mutants.out.old/
