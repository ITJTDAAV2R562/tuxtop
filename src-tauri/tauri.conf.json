{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tuxtop",
  "version": "0.6.0",
  "identifier": "dev.tuxtop.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tuxtop",
        "width": 1240,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "transparent": true,
        "decorations": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "startMenuFolder": "Tuxtop"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzMkFCOUU0MTczODY1REYKUldUZlpUZ1g1TGtxNDJwdUFDeWZBcUsxaUNvMG9DUDFNbFhiUFEyTzZKM3owSzdEOGFHOFV5OUYK",
      "endpoints": [
        "https://github.com/ITJTDAAV2R562/tuxtop/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
